import pandas as pd

# 1. Load the data
file_path = "your_file.csv"

try:
    df = pd.read_csv(file_path)
    print(f"✅ Successfully loaded {len(df)} rows.")
    print(f"Columns: {df.columns.tolist()}")
except FileNotFoundError:
    print(f"❌ Error: File not found at '{file_path}'. Check your path and filename.")
except Exception as e:
    print(f"❌ Error loading file: {e}")
    raise

# 2. Parse the Date column
# Ensure the column name matches exactly what is in your CSV (check for spaces)
# If your CSV header is 'Date', this works. If it's 'Date ', ' date', etc., fix it below.
date_col = 'Date' 

# Check if the column exists
if date_col not in df.columns:
    # Try to find a close match if exact match fails
    cols = [c for c in df.columns if 'date' in c.lower()]
    if cols:
        date_col = cols[0]
        print(f"⚠️  Exact 'Date' column not found. Using '{date_col}' instead.")
    else:
        print(f"❌ Error: No 'Date' column found. Available columns: {df.columns.tolist()}")
        raise ValueError("Date column missing.")

# Parse date. Format is MM/DD/YYYY based on your previous snippet.
try:
    df['Date'] = pd.to_datetime(df[date_col], format='%m/%d/%Y')
except Exception as e:
    print(f"❌ Error parsing dates: {e}. Some dates might be malformed.")
    # Fallback: try without strict format if standard parsing fails
    df['Date'] = pd.to_datetime(df[date_col], errors='coerce')

# 3. Create Month Helper
df['YearMonth'] = df['Date'].dt.to_period('M')

# 4. Define Duplicate Columns
# Ensure these names match your CSV headers exactly
dup_cols = ['Job Title', 'Company', 'Location', 'YearMonth']

# Check if all columns exist
missing_cols = [c for c in dup_cols if c not in df.columns]
if missing_cols:
    print(f"❌ Error: Missing columns in dataframe: {missing_cols}")
    raise ValueError("Duplicate columns missing.")

# 5. Count Duplicates
# keep='first' marks the first occurrence as valid and flags subsequent ones
is_dup = df.duplicated(subset=dup_cols, keep='first')
num_duplicates = is_dup.sum()

print(f"🔍 Found {num_duplicates} duplicate rows based on Job Title, Company, Location, and Month.")

# 6. Remove Duplicates and Prepare Final Output
df_clean = df.drop_duplicates(subset=dup_cols, keep='first')
df_clean = df_clean.drop(columns=['YearMonth', date_col]) # Optionally drop original date if not needed

# 7. Display Results
# This line is crucial to see the output in the notebook
print(f"✅ Cleaned dataframe has {len(df_clean)} rows.")
print(df_clean.head()) # Shows the first 5 rows
